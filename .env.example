# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
# Set to true when the control plane is served over HTTPS.
SESSION_SECURE=false

# Single admin account (seeded on first boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# APISIX data plane
APISIX_ADMIN_API_URL=http://localhost:9180/apisix/admin
APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1
APISIX_GATEWAY_URL=http://localhost:9080

# Stats ingestion (APISIX data plane -> control plane)
STATS_INGEST_URL=http://localhost:3333/api/stats/ingest
STATS_INGEST_TOKEN=change-me-please
