<header class="app-header">
  <div class="header-inner">
    <a class="brand" href="/dashboard">
      <span class="brand-mark">AC</span>
      <span class="brand-name">Apisix Cache</span>
      <span class="brand-tag">OSS</span>
    </a>

    <nav>
      @if(auth.user)
        <a class="nav-link {{ request.url() === '/dashboard' ? 'current' : '' }}" href="/dashboard">Dashboard</a>
        <a class="nav-link {{ request.url().startsWith('/rules') ? 'current' : '' }}" href="/rules">Cache Rules</a>
        <span class="avatar">{{ auth.user.initials }}</span>
        @form({ route: 'session.destroy', method: 'POST' })
          <button type="submit" class="btn-ghost">Logout</button>
        @end
      @else
        <a class="nav-link" href="/login">Login</a>
      @end
    </nav>
  </div>
</header>
