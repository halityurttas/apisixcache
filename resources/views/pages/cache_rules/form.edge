@let(methodsArr = old('methods') || rule?.methods || [])
@let(cacheLockValue = old('cacheLock') || (rule ? (rule.cacheLock ? 'true' : 'false') : 'true'))
@let(isActiveValue = old('isActive') || (rule ? (rule.isActive ? 'true' : 'false') : 'true'))
@let(allowedBodyValue = old('allowedBodyFields') || (rule?.allowedBodyFields ? rule.allowedBodyFields.join(', ') : ''))
@let(queryFieldsValue = old('queryFields') || (rule?.queryFields ? rule.queryFields.join(', ') : ''))
@let(rateLimitValue = old('rateLimitRps') || (rule?.rateLimitRps ? String(rule.rateLimitRps) : ''))

@layout()
  <div class="page">
    <div class="page-header">
      <div>
        <h1>{{ rule ? 'Edit Cache Rule' : 'New Cache Rule' }}</h1>
        <p>Caching and rate limiting rules pushed to APISIX.</p>
      </div>
    </div>

    <div class="form-card">
      @form({
        route: rule ? 'cache_rules.update' : 'cache_rules.store',
        routeParams: rule ? { id: rule.id } : {},
      })
        <div class="form-grid">
          @field.root({ name: 'name' })
            @!field.label({ text: 'Name' })
            @!input.control({ type: 'text', value: rule?.name, placeholder: 'Flight search cache' })
            @!field.error()
          @end

          @field.root({ name: 'endpointPattern' })
            @!field.label({ text: 'Endpoint pattern' })
            @!input.control({ type: 'text', value: rule?.endpointPattern, placeholder: '/v1/flights/search' })
            @!field.error()
          @end

          @field.root({ name: 'upstreamUrl' })
            @!field.label({ text: 'Upstream URL' })
            @!input.control({ type: 'text', value: rule?.upstreamUrl, placeholder: 'https://api.example.com' })
            @!field.error()
          @end

          @field.root({ name: 'ttlSeconds' })
            @!field.label({ text: 'TTL (seconds)' })
            @!input.control({ type: 'number', value: String(rule?.ttlSeconds ?? 300) })
            @!field.error()
          @end

          @field.root({ name: 'rateLimitRps' })
            @!field.label({ text: 'Rate limit (req/s, optional)' })
            @!input.control({ type: 'number', value: rateLimitValue, placeholder: 'e.g. 50' })
            @!field.error()
          @end
        </div>

        <fieldset class="methods-group">
          <legend>Methods to cache</legend>
          <div class="methods-options">
            @each(method in ['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'HEAD'])
              <label class="checkbox-inline">
                <input type="checkbox" name="methods[]" value="{{ method }}" {{ methodsArr.includes(method) ? 'checked' : '' }} />
                {{ method }}
              </label>
            @end
          </div>
        </fieldset>

        <div class="form-grid">
          @field.root({ name: 'allowedBodyFields' })
            @!field.label({ text: 'Allowed body fields (comma-separated, optional)' })
            @!input.control({ type: 'text', value: allowedBodyValue, placeholder: 'origin, destination, date' })
            @!field.error()
            <span class="hint">Only these JSON body fields will be part of the cache key. Leave empty to hash the full body.</span>
          @end

          @field.root({ name: 'queryFields' })
            @!field.label({ text: 'Query fields (comma-separated, optional)' })
            @!input.control({ type: 'text', value: queryFieldsValue, placeholder: 'origin, date' })
            @!field.error()
            <span class="hint">Only these query params will be part of the cache key. Leave empty to use the full query string.</span>
          @end
        </div>

        <div class="form-grid">
          @field.root({ name: 'cacheLock' })
            @!field.label({ text: 'Cache lock (single flight)' })
            <select name="cacheLock">
              <option value="true" {{ cacheLockValue === 'true' ? 'selected' : '' }}>Enabled</option>
              <option value="false" {{ cacheLockValue === 'false' ? 'selected' : '' }}>Disabled</option>
            </select>
            @!field.error()
            <span class="hint">Prevents thundering herd: only one request reaches the upstream on a cache miss.</span>
          @end

          @field.root({ name: 'isActive' })
            @!field.label({ text: 'Status' })
            <select name="isActive">
              <option value="true" {{ isActiveValue === 'true' ? 'selected' : '' }}>Active</option>
              <option value="false" {{ isActiveValue === 'false' ? 'selected' : '' }}>Inactive</option>
            </select>
            @!field.error()
          @end
        </div>

        <div class="form-actions">
          <button type="submit">{{ rule ? 'Save Changes' : 'Create Rule' }}</button>
          <a href="/rules">Cancel</a>
        </div>
      @end
    </div>
  </div>
@end
